open EuclideanGeometry RealInnerProductSpace MeasureTheory

local notation "E2" => EuclideanSpace ℝ (Fin 2)

noncomputable section

namespace L15C

/-- Power of the point `p` with respect to the circle `s`. -/
def ClassicalPower {P : Type*} [MetricSpace P] (s : Sphere P) (p : P) : ℝ :=
  dist p s.center ^ 2 - s.radius ^ 2

/-- Radical axis of two circles: the locus of points with equal power. -/
def ClassicalRadicalAxis {P : Type*} [MetricSpace P] (s₁ s₂ : Sphere P) : Set P :=
  {p | ClassicalPower s₁ p = ClassicalPower s₂ p}

/-- Two circles are orthogonal: they meet, and at a common point the radii are perpendicular
(equivalently, the tangent lines are perpendicular). -/
def ClassicalOrthogonal (s₁ s₂ : Sphere E2) : Prop :=
  ∃ p, p ∈ s₁ ∧ p ∈ s₂ ∧ ∠ s₁.center p s₂.center = Real.pi / 2

/-- Foot of the perpendicular from `P` to the line `XY`. -/
def ClassicalFoot (X Y P : E2) : E2 :=
  (EuclideanGeometry.orthogonalProjection line[ℝ, X, Y] P : E2)

/-- Reflection of `P` in the line `XY`. -/
def ClassicalReflect (X Y P : E2) : E2 :=
  EuclideanGeometry.reflection line[ℝ, X, Y] P


instance instFactE2 : Fact (Module.finrank ℝ E2 = 2) := ⟨finrank_euclideanSpace_fin⟩

theorem mem_radicalAxis_iff {P : Type*} [MetricSpace P] (s₁ s₂ : Sphere P) (p : P) :
    p ∈ ClassicalRadicalAxis s₁ s₂ ↔
      dist p s₁.center ^ 2 - s₁.radius ^ 2 = dist p s₂.center ^ 2 - s₂.radius ^ 2 := Iff.rfl

/-! ## C1 radical centre (covered) -/

theorem cov_C1 (s₁ s₂ s₃ : Sphere E2)
    (h : ¬ Collinear ℝ ({s₁.center, s₂.center, s₃.center} : Set E2)) :
    ∃! p : E2, p ∈ ClassicalRadicalAxis s₁ s₂ ∧ p ∈ ClassicalRadicalAxis s₂ s₃ ∧
      p ∈ ClassicalRadicalAxis s₃ s₁ := by
  simp only [mem_radicalAxis_iff]
  exact CircleSystems.l14_radical_center_concurrent s₁.radius s₂.radius s₃.radius h

/-! ## C2a coaxal pencil (covered, after reparametrising the classical pencil as the library
pencil generated by the members `t₁`, `t₂`) -/

/-- Power with respect to the member `t` of the classical pencil. -/
theorem pencil_power (p u : ℂ) (q v t : ℝ) (S : Sphere ℂ)
    (h : S.center = p + t * u ∧ S.radius ^ 2 = Complex.normSq (p + t * u) - (q + t * v))
    (z : ℂ) :
    ClassicalPower S z = Complex.normSq z - 2 * (z.re * p.re + z.im * p.im) + q +
      t * (v - 2 * (z.re * u.re + z.im * u.im)) := by
  rw [ClassicalPower, h.2, h.1, Complex.dist_eq, Complex.sq_norm]
  simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im, Complex.add_re,
    Complex.add_im, Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
  ring

theorem cov_C2a (p u : ℂ) (q v : ℝ) (t₁ t₂ t₃ t₄ : ℝ) (S₁ S₂ S₃ S₄ : Sphere ℂ)
    (h₁ : S₁.center = p + t₁ * u ∧ S₁.radius ^ 2 = Complex.normSq (p + t₁ * u) - (q + t₁ * v))
    (h₂ : S₂.center = p + t₂ * u ∧ S₂.radius ^ 2 = Complex.normSq (p + t₂ * u) - (q + t₂ * v))
    (h₃ : S₃.center = p + t₃ * u ∧ S₃.radius ^ 2 = Complex.normSq (p + t₃ * u) - (q + t₃ * v))
    (h₄ : S₄.center = p + t₄ * u ∧ S₄.radius ^ 2 = Complex.normSq (p + t₄ * u) - (q + t₄ * v))
    (h₁₂ : t₁ ≠ t₂) (h₃₄ : t₃ ≠ t₄) :
    ClassicalRadicalAxis S₁ S₂ = ClassicalRadicalAxis S₃ S₄ := by
  have hd : t₂ - t₁ ≠ 0 := sub_ne_zero.2 h₁₂.symm
  -- library parameters of the members `t₃`, `t₄` in the pencil generated by `S₁`, `S₂`
  set σ₃ := (t₃ - t₁) / (t₂ - t₁)
  set σ₄ := (t₄ - t₁) / (t₂ - t₁)
  have hσ : σ₃ ≠ σ₄ := by
    intro h; apply h₃₄
    have := congrArg (· * (t₂ - t₁)) h
    simp only [σ₃, σ₄, div_mul_cancel₀ _ hd] at this
    linarith
  have hmem : ∀ (σ t : ℝ) (S : Sphere ℂ), σ = (t - t₁) / (t₂ - t₁) →
      (S.center = p + t * u ∧ S.radius ^ 2 = Complex.normSq (p + t * u) - (q + t * v)) →
      ∀ z, ClassicalPower S z = CircleSystems.pencilPow S₁.center S₁.radius S₂.center S₂.radius σ z := by
    intro σ t S hσ' hS z
    have e : t = t₁ + σ * (t₂ - t₁) := by rw [hσ', div_mul_cancel₀ _ hd]; ring
    show _ = (1 - σ) * ClassicalPower S₁ z + σ * ClassicalPower S₂ z
    rw [pencil_power p u q v t S hS,
      pencil_power p u q v t₁ S₁ h₁, pencil_power p u q v t₂ S₂ h₂, e]
    ring
  ext z
  show ClassicalPower S₁ z = ClassicalPower S₂ z ↔ ClassicalPower S₃ z = ClassicalPower S₄ z
  rw [hmem σ₃ t₃ S₃ rfl h₃, hmem σ₄ t₄ S₄ rfl h₄, CircleSystems.pencilPow_eq_iff _ _ _ _ hσ]
  exact Iff.rfl

/-! ## C2b orthogonality (covered) -/

theorem cov_C2b (s₁ s₂ : Sphere E2) (h₁ : 0 < s₁.radius) (h₂ : 0 < s₂.radius) :
    ClassicalOrthogonal s₁ s₂ ↔
      dist s₁.center s₂.center ^ 2 = s₁.radius ^ 2 + s₂.radius ^ 2 := by
  rw [← CircleSystems.powPt_eq_sq_iff_dist, ← CircleSystems.isOrthogonal_iff h₁ h₂]
  unfold ClassicalOrthogonal CircleSystems.IsOrthogonal
  refine exists_congr fun X => ?_
  rw [mem_sphere, mem_sphere, EuclideanGeometry.angle,
    ← InnerProductGeometry.inner_eq_zero_iff_angle_eq_pi_div_two, vsub_eq_sub, vsub_eq_sub,
    ← neg_sub X, ← neg_sub X, inner_neg_neg]

/-! ## C3 Johnson: library proves it for the explicit points `Oᵢ + Oⱼ − H`;
NEW PROOF: these are the second intersections, and the circle through them is unique -/

/-- Two circles of radius `r` through `H` meet again only at `O₁ + O₂ − H`. -/
theorem second_intersection {H O₁ O₂ P : E2} {r : ℝ} (h₁ : dist O₁ H = r) (h₂ : dist O₂ H = r)
    (h₁₂ : O₁ ≠ O₂) (hP : P ≠ H ∧ dist P O₁ = r ∧ dist P O₂ = r) : P = O₁ + O₂ - H := by
  obtain ⟨hPH, hP₁, hP₂⟩ := hP
  have q₁ : dist (O₁ + O₂ - H) O₁ = r := by
    rw [dist_eq_norm, show O₁ + O₂ - H - O₁ = O₂ - H by abel, ← dist_eq_norm, h₂]
  have q₂ : dist (O₁ + O₂ - H) O₂ = r := by
    rw [dist_eq_norm, show O₁ + O₂ - H - O₂ = O₁ - H by abel, ← dist_eq_norm, h₁]
  have hH₁ : dist H O₁ = r := by rw [dist_comm]; exact h₁
  have hH₂ : dist H O₂ = r := by rw [dist_comm]; exact h₂
  rcases eq_of_dist_eq_of_dist_eq_of_finrank_eq_two finrank_euclideanSpace_fin h₁₂ hPH.symm
      hH₁ hP₁ q₁ hH₂ hP₂ q₂ with h | h
  · -- tangent case `O₁ + O₂ − H = H`: then `P = H`, contradiction
    exfalso; apply hPH
    have e2 : O₂ - H = H - O₁ := by
      have := congrArg (· - H) h; simp only [sub_self] at this
      linear_combination (norm := abel_nf) this
    rw [dist_eq_norm] at hP₁ hP₂ hH₁
    have a1 : P - O₁ = (P - H) + (H - O₁) := by abel
    have a2 : P - O₂ = (P - H) - (H - O₁) := by rw [← e2]; abel
    rw [a1] at hP₁; rw [a2] at hP₂
    have s1 := norm_add_sq_real (P - H) (H - O₁)
    have s2 := norm_sub_sq_real (P - H) (H - O₁)
    rw [hP₁, hH₁] at s1; rw [hP₂, hH₁] at s2
    have : ‖P - H‖ ^ 2 = 0 := by linarith
    exact sub_eq_zero.1 (norm_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 this))
  · exact h.symm

theorem cov_C3_part (H O₁ O₂ O₃ : E2) (r : ℝ)
    (h₁ : dist O₁ H = r) (h₂ : dist O₂ H = r) (h₃ : dist O₃ H = r) :
    dist (O₂ + O₃ - H) (O₁ + O₂ + O₃ - (2 : ℝ) • H) = r ∧
    dist (O₃ + O₁ - H) (O₁ + O₂ + O₃ - (2 : ℝ) • H) = r ∧
    dist (O₁ + O₂ - H) (O₁ + O₂ + O₃ - (2 : ℝ) • H) = r :=
  CircleSystems.l14_johnson_circle (by rwa [dist_comm]) (by rwa [dist_comm]) (by rwa [dist_comm])

theorem cov_C3 (H O₁ O₂ O₃ : E2) (r : ℝ)
    (h₁ : dist O₁ H = r) (h₂ : dist O₂ H = r) (h₃ : dist O₃ H = r)
    (h₁₂ : O₁ ≠ O₂) (h₂₃ : O₂ ≠ O₃) (h₁₃ : O₁ ≠ O₃)
    (P₁₂ P₂₃ P₁₃ : E2)
    (hP₁₂ : P₁₂ ≠ H ∧ dist P₁₂ O₁ = r ∧ dist P₁₂ O₂ = r)
    (hP₂₃ : P₂₃ ≠ H ∧ dist P₂₃ O₂ = r ∧ dist P₂₃ O₃ = r)
    (hP₁₃ : P₁₃ ≠ H ∧ dist P₁₃ O₁ = r ∧ dist P₁₃ O₃ = r)
    (w : E2) (R : ℝ) (hw₁ : dist P₁₂ w = R) (hw₂ : dist P₂₃ w = R) (hw₃ : dist P₁₃ w = R) :
    R = r := by
  have e₁₂ := second_intersection h₁ h₂ h₁₂ hP₁₂
  have e₂₃ := second_intersection h₂ h₃ h₂₃ hP₂₃
  have e₁₃ := second_intersection h₁ h₃ h₁₃ hP₁₃
  obtain ⟨jA, jB, jC⟩ := cov_C3_part H O₁ O₂ O₃ r h₁ h₂ h₃
  set J := O₁ + O₂ + O₃ - (2 : ℝ) • H
  have dA : dist P₂₃ J = r := by rw [e₂₃]; exact jA
  have dB : dist P₁₃ J = r := by rw [e₁₃, add_comm O₁ O₃]; exact jB
  have dC : dist P₁₂ J = r := by rw [e₁₂]; exact jC
  have n1 : P₁₂ ≠ P₂₃ := by
    rw [e₁₂, e₂₃]; intro h; apply h₁₃; have := congrArg (· + H - O₂) h; simp at this
    exact this
  have n2 : P₁₂ ≠ P₁₃ := by
    rw [e₁₂, e₁₃]; intro h; apply h₂₃; have := congrArg (· + H - O₁) h; simpa using h
  have n3 : P₂₃ ≠ P₁₃ := by
    rw [e₂₃, e₁₃]; intro h; apply h₁₂; have := congrArg (· + H - O₃) h
    simp only [sub_add_cancel] at this; linear_combination (norm := abel_nf) -this
  have hcos : Cospherical ({P₁₂, P₂₃, P₁₃} : Set E2) := by
    refine ⟨J, r, ?_⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rintro p (rfl | rfl | rfl) <;> assumption
  have hind := hcos.affineIndependent_of_ne n1 n2 n3
  set t : Affine.Triangle ℝ E2 := ⟨_, hind⟩
  have htop : affineSpan ℝ (Set.range t.points) = ⊤ :=
    t.independent.affineSpan_eq_top_iff_card_eq_finrank_add_one.2
      (by rw [Fintype.card_fin, finrank_euclideanSpace_fin])
  have hJ : J = t.circumcenter :=
    t.eq_circumcenter_of_dist_eq (by rw [htop]; exact AffineSubspace.mem_top _ _ _) (r := r)
      (fun i => by fin_cases i <;> simp [t, dA, dB, dC])
  have hw : w = t.circumcenter :=
    t.eq_circumcenter_of_dist_eq (by rw [htop]; exact AffineSubspace.mem_top _ _ _) (r := R)
      (fun i => by fin_cases i <;> simp [t, hw₁, hw₂, hw₃])
  rw [← hw₁, hw, ← hJ, dC]

/-! ## C4 Simson–Wallace (covered) -/

theorem cov_C4 (t : Affine.Triangle ℝ E2) (P : E2) :
    Collinear ℝ ({ClassicalFoot (t.points 1) (t.points 2) P,
        ClassicalFoot (t.points 2) (t.points 0) P,
        ClassicalFoot (t.points 0) (t.points 1) P} : Set E2) ↔
      P ∈ t.circumsphere := by
  rw [mem_sphere, Affine.Simplex.circumsphere_center, Affine.Simplex.circumsphere_radius]
  exact CircleSystems.l14_simson_wallace (t.dist_circumcenter_eq_circumradius 0)
    (t.dist_circumcenter_eq_circumradius 1) (t.dist_circumcenter_eq_circumradius 2)
    (affineIndependent_iff_not_collinear_set.1 (by
      have e : ![t.points 0, t.points 1, t.points 2] = t.points := by
        ext i : 1; fin_cases i <;> rfl
      rw [e]; exact t.independent))

/-! ## C5 Steiner line (covered) -/

theorem cov_C5b (t : Affine.Triangle ℝ E2) (P : E2) (hP : P ∈ t.circumsphere) :
    Collinear ℝ ({ClassicalReflect (t.points 1) (t.points 2) P,
        ClassicalReflect (t.points 2) (t.points 0) P,
        ClassicalReflect (t.points 0) (t.points 1) P, t.orthocenter} : Set E2) := by
  have h := CircleSystems.l14_steiner_line_orthocenter t (P := P) (by
    rw [mem_sphere, Affine.Simplex.circumsphere_center, Affine.Simplex.circumsphere_radius] at hP
    exact hP)
  refine h.subset ?_
  intro x; simp only [Set.mem_insert_iff, Set.mem_singleton_iff, ClassicalReflect]; tauto

theorem cov_C5a (t : Affine.Triangle ℝ E2) (P : E2) (hP : P ∈ t.circumsphere) :
    Collinear ℝ ({ClassicalReflect (t.points 1) (t.points 2) P,
        ClassicalReflect (t.points 2) (t.points 0) P,
        ClassicalReflect (t.points 0) (t.points 1) P} : Set E2) :=
  (cov_C5b t P hP).subset (by intro x; simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; tauto)


/-! ## Verbatim classical statements (copied from PaperIClassical.lean, proved from `cov_`) -/

theorem classical_C1 (s₁ s₂ s₃ : Sphere E2)
    (h : ¬ Collinear ℝ ({s₁.center, s₂.center, s₃.center} : Set E2)) :
    ∃! p : E2, p ∈ ClassicalRadicalAxis s₁ s₂ ∧ p ∈ ClassicalRadicalAxis s₂ s₃ ∧
      p ∈ ClassicalRadicalAxis s₃ s₁ := by
  exact cov_C1 s₁ s₂ s₃ h

theorem classical_C2a (p u : ℂ) (q v : ℝ) (t₁ t₂ t₃ t₄ : ℝ) (S₁ S₂ S₃ S₄ : Sphere ℂ)
    (h₁ : S₁.center = p + t₁ * u ∧ S₁.radius ^ 2 = Complex.normSq (p + t₁ * u) - (q + t₁ * v))
    (h₂ : S₂.center = p + t₂ * u ∧ S₂.radius ^ 2 = Complex.normSq (p + t₂ * u) - (q + t₂ * v))
    (h₃ : S₃.center = p + t₃ * u ∧ S₃.radius ^ 2 = Complex.normSq (p + t₃ * u) - (q + t₃ * v))
    (h₄ : S₄.center = p + t₄ * u ∧ S₄.radius ^ 2 = Complex.normSq (p + t₄ * u) - (q + t₄ * v))
    (h₁₂ : t₁ ≠ t₂) (h₃₄ : t₃ ≠ t₄) :
    ClassicalRadicalAxis S₁ S₂ = ClassicalRadicalAxis S₃ S₄ := by
  exact cov_C2a p u q v t₁ t₂ t₃ t₄ S₁ S₂ S₃ S₄ h₁ h₂ h₃ h₄ h₁₂ h₃₄

theorem classical_C2b (s₁ s₂ : Sphere E2) (h₁ : 0 < s₁.radius) (h₂ : 0 < s₂.radius) :
    ClassicalOrthogonal s₁ s₂ ↔
      dist s₁.center s₂.center ^ 2 = s₁.radius ^ 2 + s₂.radius ^ 2 := by
  exact cov_C2b s₁ s₂ h₁ h₂

theorem classical_C3 (H O₁ O₂ O₃ : E2) (r : ℝ)
    (h₁ : dist O₁ H = r) (h₂ : dist O₂ H = r) (h₃ : dist O₃ H = r)
    (h₁₂ : O₁ ≠ O₂) (h₂₃ : O₂ ≠ O₃) (h₁₃ : O₁ ≠ O₃)
    (P₁₂ P₂₃ P₁₃ : E2)
    (hP₁₂ : P₁₂ ≠ H ∧ dist P₁₂ O₁ = r ∧ dist P₁₂ O₂ = r)
    (hP₂₃ : P₂₃ ≠ H ∧ dist P₂₃ O₂ = r ∧ dist P₂₃ O₃ = r)
    (hP₁₃ : P₁₃ ≠ H ∧ dist P₁₃ O₁ = r ∧ dist P₁₃ O₃ = r)
    (w : E2) (R : ℝ) (hw₁ : dist P₁₂ w = R) (hw₂ : dist P₂₃ w = R) (hw₃ : dist P₁₃ w = R) :
    R = r := by
  exact cov_C3 H O₁ O₂ O₃ r h₁ h₂ h₃ h₁₂ h₂₃ h₁₃ P₁₂ P₂₃ P₁₃ hP₁₂ hP₂₃ hP₁₃ w R hw₁ hw₂ hw₃

theorem classical_C4 (t : Affine.Triangle ℝ E2) (P : E2) :
    Collinear ℝ ({ClassicalFoot (t.points 1) (t.points 2) P,
        ClassicalFoot (t.points 2) (t.points 0) P,
        ClassicalFoot (t.points 0) (t.points 1) P} : Set E2) ↔
      P ∈ t.circumsphere := by
  exact cov_C4 t P

theorem classical_C5a (t : Affine.Triangle ℝ E2) (P : E2) (hP : P ∈ t.circumsphere) :
    Collinear ℝ ({ClassicalReflect (t.points 1) (t.points 2) P,
        ClassicalReflect (t.points 2) (t.points 0) P,
        ClassicalReflect (t.points 0) (t.points 1) P} : Set E2) := by
  exact cov_C5a t P hP

theorem classical_C5b (t : Affine.Triangle ℝ E2) (P : E2) (hP : P ∈ t.circumsphere) :
    Collinear ℝ ({ClassicalReflect (t.points 1) (t.points 2) P,
        ClassicalReflect (t.points 2) (t.points 0) P,
        ClassicalReflect (t.points 0) (t.points 1) P, t.orthocenter} : Set E2) := by
  exact cov_C5b t P hP

