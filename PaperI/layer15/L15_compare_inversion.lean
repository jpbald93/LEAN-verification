import Inversion

/-!
# Layer 15 comparison: classical inversion statements (I1–I5) vs the `Inversion` library

Classical definitions/statements copied verbatim from `PaperIClassical.lean` (sha256 prefix
`1c595a90ccb3925a`), namespace renamed to `L15CmpInversion`. `I1c` is handled in the arbelos
comparison file (it uses `Arbelos.image_inversion_sphere`).
-/

open EuclideanGeometry RealInnerProductSpace MeasureTheory

local notation "E2" => EuclideanSpace ℝ (Fin 2)

noncomputable section

namespace L15CmpInversion

/-! ## Verbatim classical definitions -/

/-- Four distinct collinear points lie on their line in the cyclic order `A, B, C, D`
(some cyclic rotation of `A, B, C, D` is monotone along the line). -/
def ClassicalLineCyclicOrder (A B C D : E2) : Prop :=
  (Sbtw ℝ A B C ∧ Sbtw ℝ B C D) ∨ (Sbtw ℝ B C D ∧ Sbtw ℝ C D A) ∨
    (Sbtw ℝ C D A ∧ Sbtw ℝ D A B) ∨ (Sbtw ℝ D A B ∧ Sbtw ℝ A B C)

/-- The Peaucellier cell: `OA = OB = b`, rhombus `PAQB` of side `a` (`P ≠ Q`, `A ≠ B`). -/
def ClassicalPeaucellierCell (O A B P Q : E2) (a b : ℝ) : Prop :=
  dist O A = b ∧ dist O B = b ∧ dist P A = a ∧ dist A Q = a ∧ dist Q B = a ∧ dist B P = a ∧
    A ≠ B ∧ P ≠ Q

/-- A circle with *signed* radius: `(centre, ρ)`, `ρ ≠ 0`; `ρ < 0` marks an enclosing
circle.  Signed curvature is `1/ρ`.  Two such circles are tangent in the Descartes sense:
both positive → externally tangent; one negative → the positive one is inside the negative
one and internally tangent to it; never both negative. -/
def ClassicalSignedTangent (x y : E2 × ℝ) : Prop :=
  x.2 ≠ 0 ∧ y.2 ≠ 0 ∧ ¬ (x.2 < 0 ∧ y.2 < 0) ∧
    ((x.2 < 0 ∨ y.2 < 0) → x.2 + y.2 < 0) ∧ dist x.1 y.1 = |x.2 + y.2|

/-- `n` mutually tangent circles with signed radii (Descartes configuration for `n = 4`). -/
def ClassicalMutuallyTangent {n : ℕ} (C : Fin n → E2 × ℝ) : Prop :=
  (∀ i, (C i).2 ≠ 0) ∧ ∀ i j, i ≠ j → ClassicalSignedTangent (C i) (C j)

/-- The Apollonian packing generated by a Descartes quadruple: the smallest family of
(signed) circles containing the initial four and containing every circle tangent to any three
mutually tangent circles of the family. -/
inductive ClassicalApollonian (init : Fin 4 → E2 × ℝ) : E2 × ℝ → Prop
  | base (i : Fin 4) : ClassicalApollonian init (init i)
  | step (x y z w : E2 × ℝ) :
      ClassicalApollonian init x → ClassicalApollonian init y → ClassicalApollonian init z →
      ClassicalMutuallyTangent ![x, y, z, w] → ClassicalApollonian init w

/-! ## Helpers -/

/-- Mathlib inversion about `O` is the library inversion about `0` conjugated by translation. -/
theorem inversion_eq_translate (O P : E2) (k : ℝ) :
    inversion O k P = inversion (0 : E2) k (P - O) + O := by
  simp only [inversion, vsub_eq_sub, vadd_eq_add, sub_zero, add_zero, dist_eq_norm]

/-- The set `{Y | ⟪Y - O, C⟫ = κ}` (`C ≠ 0`) is an affine line of the plane. -/
theorem exists_line (O C : E2) (hC : C ≠ 0) (κ : ℝ) :
    ∃ L : AffineSubspace ℝ E2, Module.finrank ℝ L.direction = 1 ∧
      ∀ Y, Y ∈ L ↔ inner ℝ (Y - O) C = κ := by
  have : Fact (Module.finrank ℝ E2 = 1 + 1) := ⟨by simp⟩
  have hn : 0 < ‖C‖ := norm_pos_iff.2 hC
  refine ⟨AffineSubspace.mk' (O + (κ / ‖C‖ ^ 2) • C) (ℝ ∙ C)ᗮ, ?_, ?_⟩
  · rw [AffineSubspace.direction_mk']
    exact Submodule.finrank_orthogonal_span_singleton hC
  · intro Y
    rw [AffineSubspace.mem_mk', vsub_eq_sub, Submodule.mem_orthogonal_singleton_iff_inner_right,
      show Y - (O + (κ / ‖C‖ ^ 2) • C) = (Y - O) - (κ / ‖C‖ ^ 2) • C by abel,
      inner_sub_right, real_inner_smul_right, real_inner_self_eq_norm_sq, real_inner_comm]
    constructor <;> intro h
    · field_simp at h; linarith
    · field_simp; linarith

/-- The standard isometry `E2 ≃ ℂ`. -/
abbrev e : E2 ≃ₗᵢ[ℝ] ℂ := Complex.orthonormalBasisOneI.repr.symm

/-! ## I1 basic inversion -/

/-- I1a, verbatim. From `invPt_ne_zero`, `l14_invPt_invPt` (centre `0`) by translation. -/
theorem cov_classical_I1a (O : E2) (k : ℝ) (hk : 0 < k) (P : E2) (hP : P ≠ O) :
    inversion O k P ≠ O ∧ inversion O k (inversion O k P) = P := by
  have hk0 : k ≠ 0 := hk.ne'
  refine ⟨?_, ?_⟩
  · rw [inversion_eq_translate, ← Inversion.invPt_eq_inversion]
    intro h
    exact Inversion.invPt_ne_zero hk0 (sub_ne_zero.2 hP) (by simpa using h)
  · rw [inversion_eq_translate O (inversion O k P), inversion_eq_translate O P, add_sub_cancel_right,
      Inversion.l14_invPt_invPt hk0, sub_add_cancel]

/-- I1b, verbatim. From `Inversion.dist_invPt` by translation. -/
theorem cov_classical_I1b (O : E2) (k : ℝ) (hk : 0 < k) (P Q : E2) (hP : P ≠ O) (hQ : Q ≠ O) :
    dist (inversion O k P) (inversion O k Q) = k ^ 2 * dist P Q / (dist O P * dist O Q) := by
  rw [inversion_eq_translate O P, inversion_eq_translate O Q, dist_add_right,
    ← Inversion.invPt_eq_inversion, ← Inversion.invPt_eq_inversion,
    Inversion.dist_invPt k (sub_ne_zero.2 hP) (sub_ne_zero.2 hQ), dist_sub_right,
    dist_comm O P, dist_comm O Q, dist_eq_norm P O, dist_eq_norm Q O]

/-- I1d, verbatim. From `l14_invPt_image_circle` by translation (`C = c - O`). -/
theorem cov_classical_I1d (O : E2) (k : ℝ) (hk : 0 < k) (c : E2) (ρ : ℝ) (hρ : 0 < ρ)
    (hO : dist O c = ρ) :
    ∃ L : AffineSubspace ℝ E2, Module.finrank ℝ L.direction = 1 ∧
      inversion O k '' (Metric.sphere c ρ \ {O}) = (L : Set E2) := by
  set C := c - O with hCdef
  have hCn : ‖C‖ = ρ := by rw [hCdef, ← dist_eq_norm, dist_comm, hO]
  have hC : C ≠ 0 := by intro h; rw [h, norm_zero] at hCn; linarith
  obtain ⟨L, hL, hmem⟩ := exists_line O C hC (k ^ 2 / 2)
  have lib := Inversion.l14_invPt_image_circle (hk.ne') C
  refine ⟨L, hL, ?_⟩
  ext Y
  constructor
  · rintro ⟨P, ⟨hP, hPO⟩, rfl⟩
    rw [SetLike.mem_coe, hmem, inversion_eq_translate, add_sub_cancel_right]
    have : inversion (0 : E2) k (P - O) ∈ inversion (0 : E2) k ''
        {X | ‖X - C‖ = ‖C‖ ∧ X ≠ 0} := by
      refine ⟨P - O, ⟨?_, sub_ne_zero.2 hPO⟩, rfl⟩
      rw [hCn, hCdef, show P - O - (c - O) = P - c by abel, ← dist_eq_norm]
      exact hP
    rw [lib] at this
    exact this
  · intro hY
    rw [SetLike.mem_coe, hmem] at hY
    have : Y - O ∈ {Y | inner ℝ Y C = k ^ 2 / 2} := hY
    rw [← lib] at this
    obtain ⟨X, ⟨hX, hX0⟩, hXY⟩ := this
    refine ⟨X + O, ⟨?_, ?_⟩, ?_⟩
    · show dist (X + O) c = ρ
      rw [dist_eq_norm, show X + O - c = X - C by rw [hCdef]; abel, hX, hCn]
    · intro h; exact hX0 (by simpa using h)
    · rw [inversion_eq_translate, add_sub_cancel_right, hXY, sub_add_cancel]

/-! ## I2 Ptolemy -/

/-- I2a, verbatim. From `Inversion.ptolemy_inequality` with origin `B` (degenerate cases
`A = B`, `C = B`, `D = B` direct). -/
theorem cov_classical_I2a (A B C D : E2) :
    dist A C * dist B D ≤ dist A B * dist C D + dist B C * dist D A := by
  by_cases hA : A = B
  · subst hA; rw [dist_self, zero_mul, zero_add, dist_comm D A, mul_comm]
  by_cases hC : C = B
  · subst hC; rw [dist_self, zero_mul, add_zero]
  by_cases hD : D = B
  · subst hD; rw [dist_self, mul_zero]; positivity
  have h := Inversion.ptolemy_inequality (sub_ne_zero.2 hA) (sub_ne_zero.2 hD) (sub_ne_zero.2 hC)
  rw [dist_sub_right, dist_sub_right, dist_sub_right, ← dist_eq_norm, ← dist_eq_norm,
    ← dist_eq_norm] at h
  simp only [dist_comm D B, dist_comm A D, dist_comm C B, dist_comm D C, dist_comm B A] at h
  linarith [h, mul_comm (dist D A) (dist B C), mul_comm (dist C D) (dist A B)]

/-- I2b, part proved by the repository: for distinct points, Ptolemy's equality is equivalent to
the betweenness `Wbtw` of the images under inversion about `B` (in coordinates centred at `B`).
From `l14_ptolemy_iff_dist_add_dist_invPt` and `dist_add_dist_eq_iff`. -/
theorem cov_classical_I2b_part (A B C D : E2)
    (hAB : A ≠ B) (hBC : B ≠ C) (hBD : B ≠ D) :
    dist A B * dist C D + dist B C * dist D A = dist A C * dist B D ↔
      Wbtw ℝ (inversion (0 : E2) 1 (A - B)) (inversion (0 : E2) 1 (D - B))
        (inversion (0 : E2) 1 (C - B)) := by
  rw [← dist_add_dist_eq_iff, Inversion.l14_ptolemy_iff_dist_add_dist_invPt one_ne_zero
    (sub_ne_zero.2 hAB) (sub_ne_zero.2 hBD.symm) (sub_ne_zero.2 hBC.symm),
    dist_sub_right, dist_sub_right, dist_sub_right, ← dist_eq_norm, ← dist_eq_norm,
    ← dist_eq_norm, dist_comm D C, dist_comm A D, dist_comm A B, dist_comm D B, dist_comm C B]
  constructor <;> intro h <;> linarith

/-- Collinear case of Ptolemy's equality (one rotation). -/
theorem ptolemy_eq_of_sbtw {w x y z : E2} (h₁ : Sbtw ℝ w x y) (h₂ : Sbtw ℝ x y z) :
    dist w x * dist y z + dist x y * dist z w = dist w y * dist x z := by
  have hwxz := h₁.wbtw.trans_expand_left h₂.wbtw h₂.left_ne
  have hxz := dist_add_dist_eq_iff.2 h₂.wbtw
  have hwy := dist_add_dist_eq_iff.2 h₁.wbtw
  have hwz := dist_add_dist_eq_iff.2 hwxz
  rw [dist_comm z w, ← hwz, ← hxz, ← hwy]; ring

/-- I2b, direction (⇐): NEW PROOF (concyclic case from Mathlib's Ptolemy theorem, collinear
case by the distance identities). -/
theorem cov_classical_I2b_mpr (A B C D : E2) :
    ((Cospherical ({A, B, C, D} : Set E2) ∧ ∃ X : E2, Sbtw ℝ A X C ∧ Sbtw ℝ B X D) ∨
        ClassicalLineCyclicOrder A B C D) →
      dist A B * dist C D + dist B C * dist D A = dist A C * dist B D := by
  rintro (⟨hc, X, h1, h2⟩ | (⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩))
  · exact mul_dist_add_mul_dist_eq_mul_dist_of_cospherical hc h1.angle₁₂₃_eq_pi
      h2.angle₁₂₃_eq_pi
  · exact ptolemy_eq_of_sbtw h1 h2
  all_goals
    have := ptolemy_eq_of_sbtw h1 h2
    simp only [dist_comm C A, dist_comm D B] at this ⊢
    linarith [this]

/-! ## I3 Peaucellier -/

theorem cell_to_C {O A B P Q : E2} {a b : ℝ} (h : ClassicalPeaucellierCell O A B P Q a b) :
    ‖e (A - O)‖ = b ∧ ‖e (B - O)‖ = b ∧ dist (e (P - O)) (e (A - O)) = a ∧
      dist (e (P - O)) (e (B - O)) = a ∧ dist (e (Q - O)) (e (A - O)) = a ∧
      dist (e (Q - O)) (e (B - O)) = a ∧ e (A - O) ≠ e (B - O) ∧ e (P - O) ≠ e (Q - O) := by
  obtain ⟨hA, hB, hPA, hAQ, hQB, hBP, hAB, hPQ⟩ := h
  simp only [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.dist_map, dist_sub_right,
    ← dist_eq_norm, Ne, e.injective.eq_iff, sub_left_inj]
  exact ⟨by rw [dist_comm, hA], by rw [dist_comm, hB], hPA, by rw [dist_comm, hBP],
    by rw [dist_comm, hAQ], hQB, hAB, hPQ⟩

/-- I3a, verbatim. From `Inversion.peaucellier_collinear` (pivot `0` in `ℂ`) transported. -/
theorem cov_classical_I3a (O A B P Q : E2) (a b : ℝ) (h : ClassicalPeaucellierCell O A B P Q a b) :
    Collinear ℝ ({O, P, Q} : Set E2) := by
  obtain ⟨hA, hB, hPA, hPB, hQA, hQB, hAB, -⟩ := cell_to_C h
  have hx := Inversion.peaucellier_collinear hA hB hPA hPB hQA hQB hAB
  set p := e (P - O); set q := e (Q - O)
  by_cases hp : p = 0
  · have : P = O := by
      have := congrArg e.symm hp
      simp only [p, LinearIsometryEquiv.symm_apply_apply, map_zero] at this
      exact sub_eq_zero.1 this
    rw [this, Set.insert_eq_of_mem (Set.mem_insert _ _)]
    exact collinear_pair ℝ O Q
  have hn : p.re ^ 2 + p.im ^ 2 ≠ 0 := by
    intro h0; apply hp; apply Complex.ext <;> simp <;> nlinarith [sq_nonneg p.re, sq_nonneg p.im]
  set r := (p.re * q.re + p.im * q.im) / (p.re ^ 2 + p.im ^ 2)
  have hq : q = r • p := by
    apply Complex.ext <;> simp only [Complex.real_smul, Complex.mul_re, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, add_zero, r] <;>
      field_simp
    · linear_combination (-p.im) * hx
    · linear_combination p.re * hx
  have hQ : Q - O = r • (P - O) := by
    have := congrArg e.symm hq
    rwa [LinearIsometryEquiv.map_smul, LinearIsometryEquiv.symm_apply_apply,
      LinearIsometryEquiv.symm_apply_apply] at this
  rw [collinear_iff_of_mem (p₀ := O) (Set.mem_insert _ _)]
  refine ⟨P - O, ?_⟩
  rintro X (rfl | rfl | rfl)
  · exact ⟨0, by simp⟩
  · exact ⟨1, by simp⟩
  · exact ⟨r, by rw [← hQ, vadd_eq_add, sub_add_cancel]⟩

/-- I3b, verbatim. From `l14_peaucellier_classic` with `R = √(b² - a²)`. -/
theorem cov_classical_I3b (O A B P Q : E2) (a b : ℝ) (ha : 0 < a) (hab : a < b)
    (h : ClassicalPeaucellierCell O A B P Q a b) :
    dist O P * dist O Q = b ^ 2 - a ^ 2 := by
  obtain ⟨hA, hB, hPA, hPB, hQA, hQB, hAB, hPQ⟩ := cell_to_C h
  have hpos : 0 < b ^ 2 - a ^ 2 := by nlinarith
  have hR : Real.sqrt (b ^ 2 - a ^ 2) ≠ 0 := (Real.sqrt_pos.2 hpos).ne'
  have := (Inversion.l14_peaucellier_classic hR (Real.sq_sqrt hpos.le).symm hA hB hPA hPB hQA hQB
    hAB hPQ).2
  rw [Real.sq_sqrt hpos.le, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map,
    ← dist_eq_norm, ← dist_eq_norm] at this
  rw [dist_comm O P, dist_comm O Q]; exact this

/-- I3c, verbatim. From `l14_peaucellier_classic_line` transported, line from `exists_line`. -/
theorem cov_classical_I3c (O : E2) (a b : ℝ) (ha : 0 < a) (hab : a < b) (c : E2) (ρ : ℝ)
    (hρ : 0 < ρ) (hO : dist O c = ρ) :
    ∃ L : AffineSubspace ℝ E2, Module.finrank ℝ L.direction = 1 ∧
      ∀ A B P Q : E2, ClassicalPeaucellierCell O A B P Q a b → dist P c = ρ → Q ∈ L := by
  set C := c - O with hCdef
  have hCn : ‖C‖ = ρ := by rw [hCdef, ← dist_eq_norm, dist_comm, hO]
  have hC : C ≠ 0 := by intro h; rw [h, norm_zero] at hCn; linarith
  have hpos : 0 < b ^ 2 - a ^ 2 := by nlinarith
  have hR : Real.sqrt (b ^ 2 - a ^ 2) ≠ 0 := (Real.sqrt_pos.2 hpos).ne'
  obtain ⟨L, hL, hmem⟩ := exists_line O C hC ((b ^ 2 - a ^ 2) / 2)
  refine ⟨L, hL, fun A B P Q h hP => ?_⟩
  obtain ⟨hA, hB, hPA, hPB, hQA, hQB, hAB, hPQ⟩ := cell_to_C h
  have hPC : ‖e (P - O) - e C‖ = ‖e C‖ := by
    rw [← map_sub, LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map, hCn, hCdef,
      show P - O - (c - O) = P - c by abel, ← dist_eq_norm, hP]
  have := Inversion.l14_peaucellier_classic_line hR (Real.sq_sqrt hpos.le).symm hA hB hPA hPB hQA
    hQB hAB hPQ hPC
  rw [LinearIsometryEquiv.inner_map_map, Real.sq_sqrt hpos.le] at this
  exact (hmem Q).2 this

/-! ## I4, I5 Descartes / Soddy -/

theorem tangent_sq {x y : E2 × ℝ} (h : ClassicalSignedTangent x y) :
    dist (e x.1) (e y.1) ^ 2 = (x.2 + y.2) ^ 2 := by
  rw [LinearIsometryEquiv.dist_map, h.2.2.2.2, sq_abs]

theorem descartes_of_tangent (C : Fin 4 → E2 × ℝ) (h : ClassicalMutuallyTangent C) :
    (1 / (C 0).2 + 1 / (C 1).2 + 1 / (C 2).2 + 1 / (C 3).2) ^ 2 =
      2 * ((1 / (C 0).2) ^ 2 + (1 / (C 1).2) ^ 2 + (1 / (C 2).2) ^ 2 + (1 / (C 3).2) ^ 2) :=
  Inversion.l14_descartes (h.1 0) (h.1 1) (h.1 2) (h.1 3)
    (tangent_sq (h.2 0 1 (by decide))) (tangent_sq (h.2 0 2 (by decide)))
    (tangent_sq (h.2 0 3 (by decide))) (tangent_sq (h.2 1 2 (by decide)))
    (tangent_sq (h.2 1 3 (by decide))) (tangent_sq (h.2 2 3 (by decide)))

/-- I4, verbatim. From `l14_descartes` transported to `ℂ`. -/
theorem cov_classical_I4 (C : Fin 4 → E2 × ℝ) (h : ClassicalMutuallyTangent C) :
    (∑ i, 1 / (C i).2) ^ 2 = 2 * ∑ i, (1 / (C i).2) ^ 2 := by
  simp only [Fin.sum_univ_four]
  exact descartes_of_tangent C h

/-- I5a, verbatim. From `l14_descartes` and `l14_descartes_solve`. -/
theorem cov_classical_I5a (C : Fin 4 → E2 × ℝ) (h : ClassicalMutuallyTangent C) :
    let k := fun i => 1 / (C i).2
    k 3 = k 0 + k 1 + k 2 + 2 * Real.sqrt (k 0 * k 1 + k 1 * k 2 + k 2 * k 0) ∨
      k 3 = k 0 + k 1 + k 2 - 2 * Real.sqrt (k 0 * k 1 + k 1 * k 2 + k 2 * k 0) := by
  intro k
  exact ((Inversion.l14_descartes_solve (k 0) (k 1) (k 2) (k 3)).1
    (sub_eq_zero.2 (descartes_of_tangent C h))).2

/-- I5c, part: every circle tangent to three of the four initial circles (one Apollonian step)
has integral curvature. From `l14_descartes` and `l14_descartes_vieta` (Vieta: it is the
initial fourth curvature or `2(kᵢ+kⱼ+kₗ) - kₘ`). Stated for the triple `0,1,2` of `init`;
the other triples are the same after permuting `init`. -/
theorem cov_classical_I5c_part (init : Fin 4 → E2 × ℝ) (h : ClassicalMutuallyTangent init)
    (hint : ∀ i, ∃ n : ℤ, 1 / (init i).2 = n) (w : E2 × ℝ)
    (hw : ClassicalMutuallyTangent ![init 0, init 1, init 2, w]) :
    ∃ n : ℤ, 1 / w.2 = n := by
  have h1 := descartes_of_tangent init h
  have h2 := descartes_of_tangent _ hw
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons] at h2
  obtain ⟨n0, hn0⟩ := hint 0; obtain ⟨n1, hn1⟩ := hint 1
  obtain ⟨n2, hn2⟩ := hint 2; obtain ⟨n3, hn3⟩ := hint 3
  by_cases hne : 1 / w.2 = 1 / (init 3).2
  · exact ⟨n3, hne.trans hn3⟩
  · have := (Inversion.l14_descartes_vieta (k₁ := 1 / (init 0).2) (k₂ := 1 / (init 1).2)
      (k₃ := 1 / (init 2).2) (sub_eq_zero.2 h2) (sub_eq_zero.2 h1) hne).1
    refine ⟨2 * (n0 + n1 + n2) - n3, ?_⟩
    push_cast
    rw [← hn0, ← hn1, ← hn2, ← hn3]; linarith

end L15CmpInversion

