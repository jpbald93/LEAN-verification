                (Clifford.MorleyKernel.KP 6 (c ∘ i.succAbove) fun r => (starRingEnd ℂ) ((c ∘ i.succAbove) r)));
          (Clifford.MorleyKernel.M7g c (fun k => (starRingEnd ℂ) (c k)) (fun k => (starRingEnd ℂ) (c k) ^ 4) fun k =>
                    -c k ^ 4).det +
