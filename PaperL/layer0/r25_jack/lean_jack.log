Clifford.MorleyKernel.child_det_MN : ∀ (k : ℕ) (c : Fin (2 * k + 5) → ℂ),
  (∀ (j : Fin (2 * k + 5)), c j ≠ 0) →
    ∀ (i : Fin (2 * k + 5)),
      Clifford.MorleyKernel.crossVec
            (Clifford.MorleyKernel.KP (2 * k + 4) (c ∘ i.succAbove) fun r => (starRingEnd ℂ) ((c ∘ i.succAbove) r))
            ⟨k + 2, ⋯⟩ ≠
          0 →
        have z :=
          Clifford.MorleyKernel.levelPointN (2 * k + 4)
            (Clifford.MorleyKernel.crossVec
              (Clifford.MorleyKernel.KP (2 * k + 4) (c ∘ i.succAbove) fun r => (starRingEnd ℂ) ((c ∘ i.succAbove) r)));
        (Clifford.MorleyKernel.MN k c (fun r => (starRingEnd ℂ) (c r))
              (fun r => (starRingEnd ℂ) (c r) ^ (k + 3) - (starRingEnd ℂ) z * (starRingEnd ℂ) (c r) ^ (k + 2)) fun r =>
              z * -(-c r) ^ (k + 2) - (-c r) ^ (k + 3)).det =
          0
Clifford.MorleyKernel.child_line_P0N : ∀ (k : ℕ) (c : Fin (2 * k + 5) → ℂ),
  (∀ (j : Fin (2 * k + 5)), c j ≠ 0) →
    Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP (2 * k + 5) c fun j => (starRingEnd ℂ) (c j)) 0 = 0 →
      ∀ (i : Fin (2 * k + 5)),
        Clifford.MorleyKernel.crossVec
              (Clifford.MorleyKernel.KP (2 * k + 4) (c ∘ i.succAbove) fun r => (starRingEnd ℂ) ((c ∘ i.succAbove) r))
              ⟨k + 2, ⋯⟩ ≠
            0 →
          have z :=
            Clifford.MorleyKernel.levelPointN (2 * k + 4)
              (Clifford.MorleyKernel.crossVec
                (Clifford.MorleyKernel.KP (2 * k + 4) (c ∘ i.succAbove) fun r =>
                  (starRingEnd ℂ) ((c ∘ i.succAbove) r)));
          (Clifford.MorleyKernel.MN k c (fun r => (starRingEnd ℂ) (c r)) (fun r => (starRingEnd ℂ) (c r) ^ (k + 3))
                    fun r => -(-c r) ^ (k + 3)).det +
                (-1) ^ (k + 3) *
                    Clifford.MorleyKernel.crossVec
                      (Clifford.MorleyKernel.KP (2 * k + 5) c fun j => (starRingEnd ℂ) (c j)) ⟨k + 3, ⋯⟩ *
                  z +
              (Clifford.MorleyKernel.MN k c (fun r => (starRingEnd ℂ) (c r)) (fun r => -(starRingEnd ℂ) (c r) ^ (k + 2))
                    fun r => -(-c r) ^ (k + 3)).det *
                (starRingEnd ℂ) z =
            0
