Clifford.MorleyKernel.d7_children_collinear : ∃ p u,
  u ≠ 0 ∧
    ∀ (i : Fin 7),
      Clifford.MorleyKernel.levelPointN 6
          (Clifford.MorleyKernel.crossVec
            (Clifford.MorleyKernel.KP 6 (Clifford.MorleyKernel.d7 ∘ i.succAbove) fun r =>
