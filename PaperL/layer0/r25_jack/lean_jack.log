              (Clifford.MorleyKernel.M7g c (fun k => (starRingEnd ℂ) (c k)) (fun k => -(starRingEnd ℂ) (c k) ^ 3)
                    fun k => -c k ^ 4).det *
                (starRingEnd ℂ) z =
            0
@Clifford.MorleyKernel.collinear_of_reallin : ∀ {ι : Type u_1} (z : ι → ℂ) (i0 : ι) (l m n : ℂ),
  l ≠ 0 → (∀ (i : ι), l * z i + m * (starRingEnd ℂ) (z i) + n = 0) → ∃ p u, u ≠ 0 ∧ ∀ (i : ι), ∃ t, z i = p + ↑t * u
Clifford.MorleyKernel.children_eq_of_P0_Q0 : ∀ (d : Fin 7 → ℂ),
  (∀ (j : Fin 7), d j ≠ 0) →
    Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP 7 d fun j => (starRingEnd ℂ) (d j)) 0 = 0 →
