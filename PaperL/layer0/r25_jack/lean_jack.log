@Clifford.MorleyKernel.rowRel7_scalar : ∀ {R : Type u_1} [inst : CommRing R] (x y xi yi z Z : R) (w : Fin 7 → R),
  (y ^ 4 - Z * y ^ 3) * (-xi * w 0) + -x * y ^ 3 * (-yi * w 0 - xi * w 1) + x ^ 2 * y ^ 2 * (-yi * w 1 - xi * w 2) +
              -x ^ 3 * y * (-yi * w 2 - xi * w 3) +
            x * y ^ 2 * (-yi * w 4 - xi * w 5) +
          -x ^ 2 * y * (-yi * w 5 - xi * w 6) +
        (z * x ^ 3 - x ^ 4) * (yi * w 3) -
      (yi * x - xi * y) * Clifford.MorleyKernel.g7 x y w =
    yi * x ^ 3 * (z * w 3 + w 6) + xi * y ^ 3 * (Z * w 0 - w 4)
@Clifford.MorleyKernel.M7g_mulVec : ∀ {R : Type u_1} [inst : CommRing R] (x y : Fin 7 → R) (xi yi z Z : R)
  (w : Fin 7 → R) (k : Fin 7),
  (Clifford.MorleyKernel.M7g x y (fun k => y k ^ 4 - Z * y k ^ 3) fun k => z * x k ^ 3 - x k ^ 4).mulVec
      (Clifford.MorleyKernel.u7v xi yi w) k =
    (yi * x k - xi * y k) * Clifford.MorleyKernel.g7 (x k) (y k) w + yi * x k ^ 3 * (z * w 3 + w 6) +
      xi * y k ^ 3 * (Z * w 0 - w 4)
@Clifford.MorleyKernel.det_M7_expand : ∀ {R : Type u_1} [inst : CommRing R] (x y : Fin 7 → R) (z Z : R),
  (Clifford.MorleyKernel.M7g x y (fun k => y k ^ 4 - Z * y k ^ 3) fun k => z * x k ^ 3 - x k ^ 4).det =
    (Clifford.MorleyKernel.M7g x y (fun k => y k ^ 4) fun k => -x k ^ 4).det +
          z * (Clifford.MorleyKernel.M7g x y (fun k => y k ^ 4) fun k => x k ^ 3).det +
        Z * (Clifford.MorleyKernel.M7g x y (fun k => -y k ^ 3) fun k => -x k ^ 4).det +
      z * Z * (Clifford.MorleyKernel.M7g x y (fun k => -y k ^ 3) fun k => x k ^ 3).det
@Clifford.MorleyKernel.det_M7_D : ∀ {R : Type u_1} [inst : CommRing R] (x y : Fin 7 → R),
  (Clifford.MorleyKernel.M7g x y (fun k => y k ^ 4) fun k => x k ^ 3).det =
    Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP 7 x y) 4
@Clifford.MorleyKernel.det_M7_F : ∀ {R : Type u_1} [inst : CommRing R] (x y : Fin 7 → R),
  (Clifford.MorleyKernel.M7g x y (fun k => -y k ^ 3) fun k => x k ^ 3).det =
    ↑↑(Equiv.Perm.sign Clifford.MorleyKernel.sig7) * Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP 7 x y) 0
Clifford.MorleyKernel.child_det_M7 : ∀ (c : Fin 7 → ℂ),
  (∀ (j : Fin 7), c j ≠ 0) →
    ∀ (i : Fin 7),
      Clifford.MorleyKernel.crossVec
            (Clifford.MorleyKernel.KP 6 (c ∘ i.succAbove) fun r => (starRingEnd ℂ) ((c ∘ i.succAbove) r)) ⟨3, ⋯⟩ ≠
          0 →
        have z :=
          Clifford.MorleyKernel.levelPointN 6
            (Clifford.MorleyKernel.crossVec
              (Clifford.MorleyKernel.KP 6 (c ∘ i.succAbove) fun r => (starRingEnd ℂ) ((c ∘ i.succAbove) r)));
        (Clifford.MorleyKernel.M7g c (fun k => (starRingEnd ℂ) (c k))
              (fun k => (starRingEnd ℂ) (c k) ^ 4 - (starRingEnd ℂ) z * (starRingEnd ℂ) (c k) ^ 3) fun k =>
              z * c k ^ 3 - c k ^ 4).det =
          0
Clifford.MorleyKernel.child_line_P0 : ∀ (c : Fin 7 → ℂ),
  (∀ (j : Fin 7), c j ≠ 0) →
    Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP 7 c fun j => (starRingEnd ℂ) (c j)) 0 = 0 →
      ∀ (i : Fin 7),
        Clifford.MorleyKernel.crossVec
