@Clifford.MorleyKernel.rowRelN : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y xi yi z Z : R)
  (w : Fin (2 * k + 5) → R),
  ∑ j,
        Clifford.MorleyKernel.colN k x y (y ^ (k + 3) - Z * y ^ (k + 2)) (z * -(-x) ^ (k + 2) - (-x) ^ (k + 3)) ↑j *
          Clifford.MorleyKernel.uN k xi yi w j -
      (yi * x - xi * y) * Clifford.MorleyKernel.gN k x y w =
    -yi * (-x) ^ (k + 2) * (z * w ⟨k + 2, ⋯⟩ + w ⟨2 * k + 4, ⋯⟩) + xi * y ^ (k + 2) * (Z * w 0 - w ⟨k + 3, ⋯⟩)
@Clifford.MorleyKernel.MN_mulVec : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y : Fin (2 * k + 5) → R)
  (xi yi z Z : R) (w : Fin (2 * k + 5) → R) (r : Fin (2 * k + 5)),
  (Clifford.MorleyKernel.MN k x y (fun r => y r ^ (k + 3) - Z * y r ^ (k + 2)) fun r =>
          z * -(-x r) ^ (k + 2) - (-x r) ^ (k + 3)).mulVec
      (Clifford.MorleyKernel.uN k xi yi w) r =
    (yi * x r - xi * y r) * Clifford.MorleyKernel.gN k (x r) (y r) w +
      (-yi * (-x r) ^ (k + 2) * (z * w ⟨k + 2, ⋯⟩ + w ⟨2 * k + 4, ⋯⟩) + xi * y r ^ (k + 2) * (Z * w 0 - w ⟨k + 3, ⋯⟩))
@Clifford.MorleyKernel.det_MN_left : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y a a' b : Fin (2 * k + 5) → R)
  (s : R),
  (Clifford.MorleyKernel.MN k x y (fun r => a r + s * a' r) b).det =
    (Clifford.MorleyKernel.MN k x y a b).det + s * (Clifford.MorleyKernel.MN k x y a' b).det
@Clifford.MorleyKernel.det_MN_right : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y a b b' : Fin (2 * k + 5) → R)
  (s : R),
  (Clifford.MorleyKernel.MN k x y a fun r => b r + s * b' r).det =
    (Clifford.MorleyKernel.MN k x y a b).det + s * (Clifford.MorleyKernel.MN k x y a b').det
@Clifford.MorleyKernel.det_MN_expand : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y : Fin (2 * k + 5) → R)
  (z Z : R),
  (Clifford.MorleyKernel.MN k x y (fun r => y r ^ (k + 3) - Z * y r ^ (k + 2)) fun r =>
        z * -(-x r) ^ (k + 2) - (-x r) ^ (k + 3)).det =
    (Clifford.MorleyKernel.MN k x y (fun r => y r ^ (k + 3)) fun r => -(-x r) ^ (k + 3)).det +
          z * (Clifford.MorleyKernel.MN k x y (fun r => y r ^ (k + 3)) fun r => -(-x r) ^ (k + 2)).det +
        Z * (Clifford.MorleyKernel.MN k x y (fun r => -y r ^ (k + 2)) fun r => -(-x r) ^ (k + 3)).det +
      z * Z * (Clifford.MorleyKernel.MN k x y (fun r => -y r ^ (k + 2)) fun r => -(-x r) ^ (k + 2)).det
@Clifford.MorleyKernel.det_MN_D : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y : Fin (2 * k + 5) → R),
  (Clifford.MorleyKernel.MN k x y (fun r => y r ^ (k + 3)) fun r => -(-x r) ^ (k + 2)).det =
    (-1) ^ (k + 3) * Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP (2 * k + 5) x y) ⟨k + 3, ⋯⟩
@Clifford.MorleyKernel.det_MN_F : ∀ {R : Type u_1} [inst : CommRing R] (k : ℕ) (x y : Fin (2 * k + 5) → R),
  (Clifford.MorleyKernel.MN k x y (fun r => -y r ^ (k + 2)) fun r => -(-x r) ^ (k + 2)).det =
