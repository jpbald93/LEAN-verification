                p
Clifford.MorleyKernel.hodd_one_P0_line : ∀ (d : Fin 7 → ℂ),
  Clifford.GenPosN d →
    Clifford.MorleyKernel.crossVec (Clifford.MorleyKernel.KP 7 d fun j => (starRingEnd ℂ) (d j)) 0 = 0 →
