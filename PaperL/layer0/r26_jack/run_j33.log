/-- **J33: the corner identity.** In the corner `V = 0` the subfamily's last coordinate vanishes. -/
theorem evenCornerQL_proof : EvenCornerQL := by
  intro k c h i hV hP0 _hall
  have hc : ∀ r, c r ≠ 0 := hc_of_genPos (by omega) c h
  set w := crossVec (KP (2*k+5) (c ∘ i.succAbove) (fun r => conj ((c ∘ i.succAbove) r))) with hw
  set W : ℕ → ℂ := extN w with hW
  have hV3 : crossVec (KP (2*k+6) c (fun j => conj (c j))) ⟨k + 3, by omega⟩ = 0 := by
    rw [hV]; rfl
  set tt : Fin (2*k+6) → ℂ := fun r => -c r / conj (c r) with htt
  have hinj : Function.Injective tt := by
    intro a b hab
    by_contra hne
    have hT := h.1 a b hne
    have ha : conj (c a) ≠ 0 := (_root_.map_ne_zero _).2 (hc a)
    have hb : conj (c b) ≠ 0 := (_root_.map_ne_zero _).2 (hc b)
    simp only [htt] at hab
    rw [div_eq_div_iff ha hb] at hab
    exact hT (by linear_combination hab)
  have hroot : ∀ r, (polyF k W).eval (tt r) = 0 := by
    intro r
    have hy : conj (c r) ≠ 0 := (_root_.map_ne_zero _).2 (hc r)
    have h1 := child_row_all k c (fun j => conj (c j)) i hV3 r
    have hx : c r = -(tt r * conj (c r)) := by simp only [htt]; field_simp
    have h2 : ∑ l : Fin (2 * k + 6), kpe (2 * k + 5) (-(tt r * conj (c r))) (conj (c r)) l * w l = 0 := by
      rw [← hx]; exact h1
    rw [kpe5_row_dehom] at h2
    apply polyF_eval_zero k W (c r) (hc r)
    rw [polyP, polyQ, eval_sum_C_mul_X_pow, eval_sum_C_mul_X_pow]
    have h3 : conj (c r) ^ (k + 2) * (conj (c r) * ∑ j ∈ Finset.range (k + 3), W j * tt r ^ j -
        ∑ j ∈ Finset.range (k + 3), W (k + 3 + j) * tt r ^ j) = 0 := by
      rw [← h2]; ring
    rcases mul_eq_zero.1 h3 with h4 | h4
    · exact absurd h4 (pow_ne_zero _ hy)
    · exact sub_eq_zero.1 h4
  have hF : polyF k W = 0 :=
    eq_zero_of_natDegree_lt_card_of_eval_eq_zero _ hinj hroot
      (by simpa using (polyF_natDegree_le k W).trans_lt (by omega : 2 * k + 5 < 2 * k + 6))
  have htop := polyF_coeff_top k W
  rw [hF, coeff_zero] at htop
  have hW0 : W 0 = w 0 := extN_fin w 0
  have hWL : W (2 * k + 5) = w (Fin.last _) := extN_fin w (Fin.last _)
  rw [hW0, hWL] at htop
  have hc0 : conj (w 0) ≠ 0 := (_root_.map_ne_zero _).2 hP0
  have := neg_eq_zero.1 htop.symm
  exact (mul_eq_zero.1 this).resolve_right hc0

theorem EvenCorner_proof : EvenCorner := evenCorner_of_cornerQL evenCornerQL_proof

theorem heven_inf_all :
    ∀ (k : ℕ) (c : Fin (2*k+6) → ℂ), GenPosN c → ∀ i : Fin (2*k+6),
      ∃ Y, Clifford.IsGCircleS Y ∧ EptInf (2*k+6) c ∈ Y ∧
        ∀ j : Fin (2*k+5), EptInf (2*k+4) ((c ∘ i.succAbove) ∘ j.succAbove) ∈ Y :=
  heven_inf_all_of_corner EvenCorner_proof

theorem cliffordChainS_inf (n : ℕ) (hn : 3 ≤ n) : CliffordChainS n :=
  cliffordChainS_of_corner EvenCorner_proof n hn

end Clifford.MorleyKernel

