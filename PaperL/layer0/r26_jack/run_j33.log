/-- The four dehomogenised polynomials of a child vector `W` (as `ℕ → ℂ`). -/
noncomputable def polyP (k : ℕ) (W : ℕ → ℂ) : ℂ[X] := ∑ j ∈ Finset.range (k + 3), C (W j) * X ^ j
noncomputable def polyQ (k : ℕ) (W : ℕ → ℂ) : ℂ[X] := ∑ j ∈ Finset.range (k + 3), C (W (k + 3 + j)) * X ^ j
noncomputable def polyPs (k : ℕ) (W : ℕ → ℂ) : ℂ[X] :=
  ∑ j ∈ Finset.range (k + 3), C (conj (W j)) * X ^ (k + 2 - j)
noncomputable def polyQs (k : ℕ) (W : ℕ → ℂ) : ℂ[X] :=
  ∑ j ∈ Finset.range (k + 3), C (conj (W (k + 3 + j))) * X ^ (k + 2 - j)
noncomputable def polyF (k : ℕ) (W : ℕ → ℂ) : ℂ[X] :=
  -(X * polyQ k W * polyPs k W) - polyP k W * polyQs k W

theorem eval_sum_C_mul_X_pow (s : Finset ℕ) (a : ℕ → ℂ) (e : ℕ → ℕ) (t : ℂ) :
    (∑ j ∈ s, C (a j) * X ^ (e j)).eval t = ∑ j ∈ s, a j * t ^ (e j) := by
  rw [eval_finset_sum]; simp

theorem natDegree_sum_C_mul_X_pow_le (s : Finset ℕ) (a : ℕ → ℂ) (e : ℕ → ℕ) (n : ℕ)
    (h : ∀ j ∈ s, e j ≤ n) : (∑ j ∈ s, C (a j) * X ^ (e j)).natDegree ≤ n :=
  natDegree_sum_le_of_forall_le _ _ fun j hj => (natDegree_C_mul_X_pow_le _ _).trans (h j hj)

theorem polyF_eval_zero (k : ℕ) (W : ℕ → ℂ) (c : ℂ) (hc : c ≠ 0)
    (h : conj c * (polyP k W).eval (-c / conj c) = (polyQ k W).eval (-c / conj c)) :
    (polyF k W).eval (-c / conj c) = 0 := by
  have hc' : conj c ≠ 0 := (map_ne_zero _).2 hc
  set t := -c / conj c with ht
  set u := -conj c / c with hu
  have htu : t * u = 1 := by rw [ht, hu]; field_simp; ring
  have hconjt : conj t = u := by rw [ht, hu]; simp
  set A := (polyP k W).eval t
  set B := (polyQ k W).eval t
  have hA : A = ∑ j ∈ Finset.range (k + 3), W j * t ^ j := eval_sum_C_mul_X_pow _ _ _ _
  have hB : B = ∑ j ∈ Finset.range (k + 3), W (k + 3 + j) * t ^ j := eval_sum_C_mul_X_pow _ _ _ _
  have hAs : (polyPs k W).eval t = t ^ (k + 2) * conj A := by
    rw [polyPs, eval_sum_C_mul_X_pow, hA, map_sum]
    simp only [map_mul, map_pow, hconjt]
    exact (reflect_sum_pow k (fun j => conj (W j)) t u htu).symm
  have hBs : (polyQs k W).eval t = t ^ (k + 2) * conj B := by
    rw [polyQs, eval_sum_C_mul_X_pow, hB, map_sum]
    simp only [map_mul, map_pow, hconjt]
    exact (reflect_sum_pow k (fun j => conj (W (k + 3 + j))) t u htu).symm
  have hcj : c * conj A = conj B := by
    have := congrArg conj h; simpa using this
  have hct : c = -(t * conj c) := by rw [ht]; field_simp
  simp only [polyF, eval_sub, eval_neg, eval_mul, eval_X, hAs, hBs]
  rw [← hcj, ← h]
  rw [hct]; ring
""")
