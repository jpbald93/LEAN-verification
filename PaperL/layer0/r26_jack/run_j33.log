import QLPrefix

namespace Clifford.MorleyKernel
open Complex ComplexConjugate Matrix Polynomial

section J33
variable {R : Type*} [CommRing R]

/-- The child matrix `KP (2k+5)` is the parent `KP (2k+6)` with column `k+3` deleted. -/
theorem kpe5_eq_kpe6_succAbove (k : ℕ) (x y : R) (j : Fin (2 * k + 6)) :
    kpe (2 * k + 5) x y j = kpe (2 * k + 6) x y ((⟨k + 3, by omega⟩ : Fin (2 * k + 7)).succAbove j) := by
  rw [val_succAbove]
  simp only [Fin.val_mk]
  have hj := j.isLt
  split_ifs with h
  · rw [kpe5_lo k x y _ (by omega), kpe6_lo k x y _ (by omega)]
  · rw [kpe5_hi k x y _ (by omega) (by omega), kpe6_hi k x y _ (by omega) (by omega),
      show (j : ℕ) + 1 - (k + 4) = j - (k + 3) by omega, show 2 * k + 6 - ((j : ℕ) + 1) = 2 * k + 5 - j by omega]

/-- Dehomogenised row sum of `KP (2k+5)` at `x = -(t y)`. -/
theorem kpe5_row_dehom (k : ℕ) (t y : R) (w : Fin (2 * k + 6) → R) :
    ∑ j : Fin (2 * k + 6), kpe (2 * k + 5) (-(t * y)) y j * w j =
      y ^ (k + 3) * ∑ j ∈ Finset.range (k + 3), extN w j * t ^ j -
        y ^ (k + 2) * ∑ j ∈ Finset.range (k + 3), extN w (k + 3 + j) * t ^ j := by
  have e : ∑ j : Fin (2 * k + 6), kpe (2 * k + 5) (-(t * y)) y j * w j =
      ∑ j ∈ Finset.range (2 * k + 6), kpe (2 * k + 5) (-(t * y)) y j * extN w j := by
    rw [← Fin.sum_univ_eq_sum_range (fun j => kpe (2 * k + 5) (-(t * y)) y j * extN w j)]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [extN_fin]
  rw [e, show 2 * k + 6 = (k + 3) + (k + 3) by omega, Finset.sum_range_add, Finset.mul_sum,
    Finset.mul_sum, sub_eq_add_neg, ← Finset.sum_neg_distrib]
  congr 1
  · refine Finset.sum_congr rfl fun j hj => ?_
    have hj := Finset.mem_range.1 hj
    rw [kpe5_lo k _ _ _ (by omega), neg_neg, mul_pow]
    have : y ^ (k + 3) = y ^ j * y ^ (k + 3 - j) := by rw [← pow_add]; congr 1; omega
    rw [this]; ring
  · refine Finset.sum_congr rfl fun j hj => ?_
    have hj := Finset.mem_range.1 hj
    rw [kpe5_hi k _ _ _ (by omega) (by omega), neg_neg, mul_pow,
      show k + 3 + j - (k + 3) = j by omega]
    have : y ^ (k + 2) = y ^ j * y ^ (2 * k + 5 - (k + 3 + j)) := by rw [← pow_add]; congr 1; omega
    rw [this]; ring

theorem reflect_sum_pow (k : ℕ) (a : ℕ → R) (t u : R) (htu : t * u = 1) :
    t ^ (k + 2) * ∑ j ∈ Finset.range (k + 3), a j * u ^ j =
      ∑ j ∈ Finset.range (k + 3), a j * t ^ (k + 2 - j) := by
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j hj => ?_
  have hj := Finset.mem_range.1 hj
  have : t ^ (k + 2) = t ^ (k + 2 - j) * t ^ j := by rw [← pow_add]; congr 1; omega
  rw [this]
  have h2 : t ^ j * u ^ j = 1 := by rw [← mul_pow, htu, one_pow]
  linear_combination (a j * t ^ (k + 2 - j)) * h2

end J33

end Clifford.MorleyKernel
