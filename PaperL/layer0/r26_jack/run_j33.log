theorem polyF_natDegree_le (k : ℕ) (W : ℕ → ℂ) : (polyF k W).natDegree ≤ 2 * k + 5 := by
  have hP := natDegree_sum_C_mul_X_pow_le (Finset.range (k + 3)) W (fun j => j) (k + 2)
    (fun j hj => by have := Finset.mem_range.1 hj; omega)
  have hQ := natDegree_sum_C_mul_X_pow_le (Finset.range (k + 3)) (fun j => W (k + 3 + j))
    (fun j => j) (k + 2) (fun j hj => by have := Finset.mem_range.1 hj; omega)
  have hPs := natDegree_sum_C_mul_X_pow_le (Finset.range (k + 3)) (fun j => conj (W j))
    (fun j => k + 2 - j) (k + 2) (fun j _ => by omega)
  have hQs := natDegree_sum_C_mul_X_pow_le (Finset.range (k + 3)) (fun j => conj (W (k + 3 + j)))
    (fun j => k + 2 - j) (k + 2) (fun j _ => by omega)
  have h1 : (X * polyQ k W * polyPs k W).natDegree ≤ 2 * k + 5 := by
    have := natDegree_mul_le_of_le (natDegree_mul_le_of_le (natDegree_X_le (R := ℂ)) hQ) hPs
    omega
  have h2 : (polyP k W * polyQs k W).natDegree ≤ 2 * k + 5 := by
    have := natDegree_mul_le_of_le hP hQs
    omega
  unfold polyF
  exact (natDegree_sub_le_of_le (natDegree_neg _ ▸ h1) h2).trans (by omega)

